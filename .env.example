# Copy to .env. Do not commit .env.
# Commented lines are inactive. A blank NAME= would override the code default
# with an empty string, because config uses `process.env.NAME ?? default`.

HOST=127.0.0.1
# PORT=4000
ADMIN_TOKEN=replace-with-a-long-random-token
ALLOW_LIVE_FETCH=false
AUTO_SYNC_ENABLED=true
# SYNC_INTERVAL_MS=180000
# OPS_SYNC_INTERVAL_MS=60000
# STATE_SNAPSHOT_PATH=tmp/api-state.json
# DATABASE_URL=
# CCTV_SNAPSHOT_PATH=tmp/public-cctv-state.json
# CCTV_CACHE_TTL_MS=300000
# CCTV_PROBE_TIMEOUT_MS=2500
# CCTV_PROBE_CONCURRENCY=8

# Worker only. The API process does not read API_BASE_URL.
# API_BASE_URL=http://127.0.0.1:4000

# Browser and Vite. Empty VITE_API_BASE_URL keeps dev traffic on the proxy.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
# VITE_SITE_TITLE=
# VITE_DEFAULT_CITY=
# VITE_DEFAULT_VIEW=
VITE_DEFAULT_BASEMAP=satellite
# BASE_PATH=
# GITHUB_PAGES=

# Optional credentials. Leave commented until you have a real value.
# NEWS_API_KEY=
# NEWS_API_QUERIES=
# NEWS_API_PAGE_SIZE=4
# GOOGLE_NEWS_RSS_QUERIES=
# GOOGLE_ALERTS_FEEDS=
# GDELT_DOC_ENDPOINT=
# TALKWALKER_ALERT_FEEDS=
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_IDS=
# OPENAQ_API_KEY=
# OPENAQ_ENDPOINT=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# KNOWLEDGE_DIR=
# MAX_DAILY_AI_INQUIRIES=200
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=
# COPERNICUS_TOKEN_URL=
# WAQI_API_TOKEN=

# Optional endpoint overrides. Uncomment only to replace the code default.
# EONET_ENDPOINT=
# CITYDATA_CATALOG_ENDPOINT=
# DATAGOTH_ENDPOINT=
# URBANIS_ENDPOINT=
# GISTDA_ENDPOINT=
# OPEN_METEO_WEATHER_ENDPOINT=
